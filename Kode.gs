/** Jejak Temuan 6S — Backend (Kode.gs). Tanpa login; admin lewat PIN. */
const APP = 'Jejak Temuan 6S', FOLDER = 'Jejak_Temuan_6S', SSN = 'DB_Jejak_Temuan_6S';
const KAT = ['FP', 'R1', 'R2', 'R3', 'R4', 'R5', 'W', 'Z'];
const include = f => HtmlService.createHtmlOutputFromFile(f).getContent();
const res = (s, d, m) => ({ success: s, data: d, message: m || '' });
const props = () => PropertiesService.getScriptProperties();
const db = () => SpreadsheetApp.openById(props().getProperty('SS_ID'));

// Satu entry point, tanpa ?page= (aman untuk iframe Blogger)
function doGet() {
  return HtmlService.createTemplateFromFile('Index').evaluate().setTitle(APP)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/** API untuk tampilan di Vercel: menerima {fn, args} dan membalas JSON. Hanya fungsi di daftar ini yang boleh dipanggil. */
const API = { getInit, saveTemuan, tambahFoto, cekPin, ubahPin, updateTemuan, hapusTemuan, tambahArea, exportHasil };
function doPost(e) {
  let out;
  try {
    const req = JSON.parse(e.postData.contents);
    out = API.hasOwnProperty(req.fn) ? API[req.fn].apply(null, req.args || []) : res(false, null, 'Fungsi tidak dikenal.');
  } catch (err) { out = res(false, null, 'Permintaan tidak valid: ' + err.message); }
  return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}

/** Jalankan SEKALI dari editor. Idempotent. */
function setupAppEnvironment() {
  const sub = (p, n) => { const i = p.getFoldersByName(n); return i.hasNext() ? i.next() : p.createFolder(n); };
  const fi = DriveApp.getFoldersByName(FOLDER);
  const root = fi.hasNext() ? fi.next() : DriveApp.createFolder(FOLDER);
  const foto = sub(root, 'Foto'), out = sub(root, 'Unduhan');
  const fl = root.getFilesByName(SSN);
  let s;
  if (fl.hasNext()) s = SpreadsheetApp.open(fl.next());
  else { s = SpreadsheetApp.create(SSN); DriveApp.getFileById(s.getId()).moveTo(root); }
  const mk = (n, h, rows) => {
    let sh = s.getSheetByName(n);
    if (!sh) {
      sh = s.insertSheet(n); sh.appendRow(h);
      sh.getRange(1, 1, 1, h.length).setFontWeight('bold').setBackground('#1E3A8A').setFontColor('#fff');
      if (rows) sh.getRange(2, 1, rows.length, h.length).setValues(rows);
    }
  };
  mk('Area', ['ID', 'Nama', 'Mill'], [['A1', 'General - Finishing', 'FINISHING PF 1'], ['A2', 'Loker Sortir', 'FINISHING PF 1'], ['A3', 'Sheet Stock', 'FINISHING PF 1']]);
  mk('Temuan', ['ID', 'Tanggal', 'Periode', 'AreaID', 'Remark', 'Kategori', 'FotoBefore', 'FotoAfter', 'PIC', 'Status', 'No']);
  mk('Pengaturan', ['Key', 'Value'], [['Auditee', ''], ['Auditor', '']]);
  const d = s.getSheetByName('Sheet1'); if (d && s.getSheets().length > 1) s.deleteSheet(d);
  props().setProperties({ SS_ID: s.getId(), FOTO_ID: foto.getId(), OUT_ID: out.getId() });
  if (!props().getProperty('PIN')) props().setProperty('PIN', '123456'); // GANTI lewat menu Admin
  Logger.log('Spreadsheet: ' + s.getUrl() + '\nFolder: ' + root.getUrl());
}

function rows_(name) {
  const v = db().getSheetByName(name).getDataRange().getValues(), h = v.shift();
  return v.filter(r => r[0] !== '').map(r => { const o = {}; h.forEach((k, i) => o[k] = r[i] instanceof Date ? Utilities.formatDate(r[i], 'Asia/Jakarta', 'yyyy-MM-dd HH:mm') : r[i]); return o; });
}

/** Satu panggilan memuat semua data awal (instant UX). Area di-cache 1 jam. */
function getInit() {
  try {
    ensureNo_(); const c = CacheService.getScriptCache(); let areas = c.get('areas');
    areas = areas ? JSON.parse(areas) : rows_('Area');
    c.put('areas', JSON.stringify(areas), 3600);
    const cfg = {}; rows_('Pengaturan').forEach(r => cfg[r.Key] = r.Value);
    cfg.logoApp = 'data:image/png;base64,' + LOGO_APP; cfg.logo6s = 'data:image/png;base64,' + LOGO_6S;
    return res(true, { areas, temuan: rows_('Temuan'), cfg, kat: KAT });
  } catch (e) { return res(false, null, e.message); }
}

const safe_ = s => String(s || '').replace(/\s*-\s*/g, '-').replace(/[\\/:*?"<>|]/g, '').trim().replace(/\s+/g, '_');
function areaFolder_(nama) {
  const root = DriveApp.getFolderById(props().getProperty('FOTO_ID')), n = String(nama).replace(/[\\/:*?"<>|]/g, '').trim() || 'Tanpa_Area';
  const it = root.getFoldersByName(n); return it.hasNext() ? it.next() : root.createFolder(n);
}
function areaNama_(id) { const a = rows_('Area').filter(x => x.ID === id)[0]; return a ? a.Nama : null; }
/** Kolom 'No' (K) = nomor temuan per area; dibuat otomatis untuk data lama. */
function ensureNo_() {
  const sh = db().getSheetByName('Temuan');
  if (sh.getRange(1, 11).getValue() === 'No') return;
  sh.getRange(1, 11).setValue('No').setFontWeight('bold').setBackground('#1E3A8A').setFontColor('#fff');
  const n = sh.getLastRow() - 1; if (n < 1) return;
  const cnt = {}; sh.getRange(2, 11, n, 1).setValues(sh.getRange(2, 4, n, 1).getValues().map(r => [cnt[r[0]] = (cnt[r[0]] || 0) + 1]));
}
function nextNo_(sh, areaId) {
  const v = sh.getDataRange().getValues(); let m = 0;
  for (let i = 1; i < v.length; i++) if (v[i][3] === areaId) m = Math.max(m, Number(v[i][10]) || 0);
  return m + 1;
}
/** Foto disimpan di folder area, nama: no_before_AREA.jpg / no_after_AREA.jpg */
function savePhoto_(b64, no, jenis, areaNama) {
  const blob = Utilities.newBlob(Utilities.base64Decode(b64), 'image/jpeg', no + '_' + jenis + '_' + safe_(areaNama) + '.jpg');
  const f = areaFolder_(areaNama).createFile(blob);
  f.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); // agar thumbnail tampil tanpa login
  return f.getId();
}

function saveTemuan(o) {
  const lock = LockService.getScriptLock();
  try {
    if (!o.areaId || !o.remark || o.remark.trim().length < 5) return res(false, null, 'Pilih area dan isi remark (minimal 5 karakter).');
    if (!o.before && !o.after) return res(false, null, 'Upload minimal satu foto (Before atau After).');
    const nama = areaNama_(o.areaId); if (!nama) return res(false, null, 'Area tidak ditemukan.');
    lock.waitLock(15000);
    const sh = db().getSheetByName('Temuan'), no = nextNo_(sh, o.areaId), now = new Date();
    const fb = o.before ? savePhoto_(o.before, no, 'before', nama) : '', fa = o.after ? savePhoto_(o.after, no, 'after', nama) : '';
    const per = Utilities.formatDate(now, 'Asia/Jakarta', 'yyyy-MM'), id = Utilities.getUuid();
    sh.appendRow([id, now, per, o.areaId, o.remark.trim(), '', fb, fa, '', 'Open', no]);
    return res(true, { ID: id, Tanggal: Utilities.formatDate(now, 'Asia/Jakarta', 'yyyy-MM-dd HH:mm'), Periode: per, AreaID: o.areaId, Remark: o.remark.trim(), Kategori: '', FotoBefore: fb, FotoAfter: fa, PIC: '', Status: 'Open', No: no }, 'Temuan tersimpan.');
  } catch (e) { return res(false, null, 'Gagal: ' + e.message); } finally { try { lock.releaseLock(); } catch (x) {} }
}

/** Menambah foto yang belum ada (Before/After) pada temuan yang sudah tersimpan. */
function tambahFoto(id, jenis, b64) {
  const lock = LockService.getScriptLock();
  try {
    if (!b64 || (jenis !== 'before' && jenis !== 'after')) return res(false, null, 'Data foto tidak valid.');
    lock.waitLock(15000);
    const sh = db().getSheetByName('Temuan'), r = findRow_(sh, id); if (!r) return res(false, null, 'Data tidak ditemukan.');
    const v = sh.getRange(r, 1, 1, 11).getValues()[0], col = jenis === 'before' ? 7 : 8;
    if (v[col - 1]) return res(false, null, 'Foto ' + jenis + ' sudah ada.');
    const fid = savePhoto_(b64, v[10], jenis, areaNama_(v[3]) || 'Tanpa_Area');
    sh.getRange(r, col).setValue(fid); return res(true, { id: fid }, 'Foto ditambahkan.');
  } catch (e) { return res(false, null, e.message); } finally { try { lock.releaseLock(); } catch (x) {} }
}

function cekPin(pin) { return res(String(pin) === props().getProperty('PIN'), null, 'PIN salah.'); }
function ubahPin(lama, baru) {
  if (!cekPin(lama).success) return res(false, null, 'PIN lama salah.');
  if (!/^\d{6}$/.test(baru)) return res(false, null, 'PIN baru harus 6 digit angka.');
  props().setProperty('PIN', baru); return res(true, null, 'PIN diubah.');
}

function findRow_(sh, id) {
  const ids = sh.getRange(1, 1, sh.getLastRow(), 1).getValues().map(r => r[0]);
  return ids.indexOf(id) + 1; // 0 jika tidak ada
}

function updateTemuan(pin, id, f) {
  const lock = LockService.getScriptLock();
  try {
    if (!cekPin(pin).success) return res(false, null, 'PIN salah.');
    lock.waitLock(10000);
    const sh = db().getSheetByName('Temuan'), r = findRow_(sh, id);
    if (!r) return res(false, null, 'Data tidak ditemukan.');
    const v = sh.getRange(r, 1, 1, 11).getValues()[0]; let areaId = v[3], no = v[10];
    if (f.AreaID && f.AreaID !== areaId) { // pindah area: foto dipindah ke folder area baru & diberi nama ulang
      const nama = areaNama_(f.AreaID); if (!nama) return res(false, null, 'Area tidak ditemukan.');
      no = nextNo_(sh, f.AreaID); areaId = f.AreaID;
      [['before', 7], ['after', 8]].forEach(p => { const fid = v[p[1] - 1]; if (fid) { try { const fl = DriveApp.getFileById(fid); fl.moveTo(areaFolder_(nama)); fl.setName(no + '_' + p[0] + '_' + safe_(nama) + '.jpg'); } catch (x) {} } });
      sh.getRange(r, 4).setValue(areaId); sh.getRange(r, 11).setValue(no);
    }
    sh.getRange(r, 6).setValue(f.Kategori || ''); sh.getRange(r, 9).setValue(f.PIC || ''); sh.getRange(r, 10).setValue(f.Status === 'Close' ? 'Close' : 'Open');
    return res(true, { AreaID: areaId, No: no }, 'Tersimpan.');
  } catch (e) { return res(false, null, e.message); } finally { try { lock.releaseLock(); } catch (x) {} }
}

function hapusTemuan(pin, id) {
  const lock = LockService.getScriptLock();
  try {
    if (!cekPin(pin).success) return res(false, null, 'PIN salah.');
    lock.waitLock(10000);
    const sh = db().getSheetByName('Temuan'), r = findRow_(sh, id);
    if (!r) return res(false, null, 'Data tidak ditemukan.');
    sh.getRange(r, 7, 1, 2).getValues()[0].forEach(fid => { try { DriveApp.getFileById(fid).setTrashed(true); } catch (x) {} });
    sh.deleteRow(r); return res(true, null, 'Dihapus.');
  } catch (e) { return res(false, null, e.message); } finally { try { lock.releaseLock(); } catch (x) {} }
}

function tambahArea(pin, nama, mill) {
  const lock = LockService.getScriptLock();
  try {
    if (!cekPin(pin).success) return res(false, null, 'PIN salah.');
    if (!nama || !nama.trim()) return res(false, null, 'Nama area wajib diisi.');
    lock.waitLock(10000);
    const row = ['A' + Utilities.getUuid().slice(0, 6), nama.trim(), (mill || '').trim()];
    db().getSheetByName('Area').appendRow(row);
    CacheService.getScriptCache().remove('areas');
    return res(true, { ID: row[0], Nama: row[1], Mill: row[2] }, 'Area ditambahkan.');
  } catch (e) { return res(false, null, e.message); } finally { try { lock.releaseLock(); } catch (x) {} }
}

// ═ EKSPOR — format mengikuti FORM FINDING AUDIT 6S/6K & IMPROVEMENT ═
const lg_ = (b64, n) => Utilities.newBlob(Utilities.base64Decode(b64), 'image/png', n);
const JUDUL = 'FORM FINDING AUDIT 6S/6K & IMPROVEMENT';
const HDR = ['No', 'Remark of finding', 'Location', 'Finding Category (FP, R1-5+W, Z)', 'Foto Before', 'Foto After', 'PIC', 'Status'];

function fit_(im, mw, mh) { const k = Math.min(mw / im.getWidth(), mh / im.getHeight()); im.setWidth(Math.round(im.getWidth() * k)).setHeight(Math.round(im.getHeight() * k)); }
function cell_(c, txt, o) {
  o = o || {}; const p = c.getChild(0).asParagraph();
  const s = txt == null ? '' : String(txt); if (s) p.setText(s); // setText('') menyebabkan error pada Google Docs
  p.setSpacingBefore(0).setSpacingAfter(0).setAlignment(o.al || DocumentApp.HorizontalAlignment.CENTER);
  if (p.getText()) p.editAsText().setFontFamily('Arial').setFontSize(o.sz || 9).setBold(!!o.b).setForegroundColor(o.fg || '#000000');
  c.setVerticalAlignment(DocumentApp.VerticalAlignment.CENTER).setPaddingTop(3).setPaddingBottom(3).setPaddingLeft(4).setPaddingRight(4);
  if (o.bg) c.setBackgroundColor(o.bg);
  return p;
}
function img_(c, blob, mw, mh, al) {
  const p = c.getChild(0).asParagraph();
  p.setSpacingBefore(0).setSpacingAfter(0).setAlignment(al || DocumentApp.HorizontalAlignment.CENTER);
  fit_(p.appendInlineImage(blob), mw, mh); c.setVerticalAlignment(DocumentApp.VerticalAlignment.CENTER);
}

function buatDoc_(o, areas, all, stamp) {
  const A = DocumentApp.HorizontalAlignment, d = DocumentApp.create('Finding_' + stamp), b = d.getBody();
  b.setPageWidth(842).setPageHeight(595).setMarginTop(24).setMarginBottom(24).setMarginLeft(24).setMarginRight(24);
  const ht = b.appendTable([['', '', '']]); ht.setBorderWidth(0); [150, 494, 150].forEach((w, i) => ht.setColumnWidth(i, w));
  img_(ht.getCell(0, 0), lg_(LOGO_APP, 'app.png'), 140, 46, A.LEFT);
  const tp = cell_(ht.getCell(0, 1), JUDUL, { b: 1, sz: 14 }), tt = tp.editAsText(), L = JUDUL.length;
  tt.appendText(' (' + o.tgl2.slice(0, 4) + ')'); tt.setFontSize(L, tt.getText().length - 1, 7).setBold(L, tt.getText().length - 1, false);
  img_(ht.getCell(0, 2), lg_(LOGO_6S, '6s.png'), 50, 50, A.RIGHT);
  const ln = b.appendTable([[' ']]); ln.setBorderWidth(0).setColumnWidth(0, 794);
  ln.getCell(0, 0).setBackgroundColor('#000000').setPaddingTop(0).setPaddingBottom(0).getChild(0).asParagraph().setSpacingBefore(0).setSpacingAfter(0).editAsText().setFontSize(1);
  ln.getRow(0).setMinimumHeight(3);
  const it = b.appendTable([['', '', '', ''], ['', '', '', '']]); it.setBorderWidth(0); [110, 287, 110, 287].forEach((w, i) => it.setColumnWidth(i, w));
  [['AREA / MILL', o.mill, 'AUDITOR', o.auditor], ['AUDITEE', o.auditee, 'DATE', o.tgl1 + ' - ' + o.tgl2]]
    .forEach((r, i) => r.forEach((v, j) => cell_(it.getCell(i, j), j % 2 ? ': ' + (v || '') : v, { al: A.LEFT, b: j % 2 === 0, sz: 10 })));
  let n = 0; const W = [26, 140, 80, 70, 180, 180, 62, 56];
  areas.forEach(a => {
    const its = all.filter(t => t.AreaID === a.ID).sort((x, y) => (Number(x.No) || 0) - (Number(y.No) || 0)); if (!its.length) return;
    b.appendParagraph('AREA / SUB-AREA: ' + a.Nama.toUpperCase()).setSpacingBefore(16).setSpacingAfter(4).editAsText().setFontFamily('Arial').setFontSize(10).setBold(true).setForegroundColor('#1E3A8A');
    const tb = b.appendTable([HDR]); tb.setBorderWidth(1).setBorderColor('#000000'); W.forEach((w, i) => tb.setColumnWidth(i, w));
    HDR.forEach((h, i) => cell_(tb.getCell(0, i), h, { b: 1, sz: 8, fg: '#1F3FD1' }));
    its.forEach(t => {
      const tr = tb.appendTableRow(); for (let i = 0; i < 8; i++) tr.appendTableCell(''); tr.setMinimumHeight(130);
      cell_(tr.getCell(0), t.No, { b: 1, sz: 10, bg: '#FFF176' });
      cell_(tr.getCell(1), t.Remark, { al: A.LEFT }); cell_(tr.getCell(2), a.Nama); cell_(tr.getCell(3), t.Kategori);
      [[4, t.FotoBefore], [5, t.FotoAfter]].forEach(p => { if (!p[1]) return; try { img_(tr.getCell(p[0]), DriveApp.getFileById(p[1]).getBlob(), 170, 124); } catch (e) { cell_(tr.getCell(p[0]), '(foto tidak tersedia)', { sz: 8 }); } });
      cell_(tr.getCell(6), t.PIC); cell_(tr.getCell(7), t.Status);
    });
  });
  try { b.removeChild(b.getChild(0)); } catch (e) {}
  d.saveAndClose(); return d.getId();
}

function buatXlsx_(o, areas, all, stamp) {
  const s = SpreadsheetApp.create('Finding_' + stamp), sh = s.getSheets()[0], BS = SpreadsheetApp.BorderStyle.SOLID;
  sh.setName('Finding 6S'); sh.setHiddenGridlines(true);
  [32, 210, 130, 120, 200, 200, 100, 80].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  const ogFit = (im, mw, mh) => { const k = Math.min(mw / im.getWidth(), mh / im.getHeight()); im.setWidth(Math.round(im.getWidth() * k)).setHeight(Math.round(im.getHeight() * k)); };
  sh.setRowHeight(1, 58); sh.getRange(1, 2, 1, 6).merge().setValue(JUDUL + ' (' + o.tgl2.slice(0, 4) + ')').setFontFamily('Arial').setFontWeight('bold').setFontSize(14).setHorizontalAlignment('center').setVerticalAlignment('middle');
  ogFit(sh.insertImage(lg_(LOGO_APP, 'app.png'), 1, 1, 4, 4), 130, 50); ogFit(sh.insertImage(lg_(LOGO_6S, '6s.png'), 8, 1, 10, 4), 52, 52);
  sh.setRowHeight(2, 4); sh.getRange(2, 1, 1, 8).setBackground('#000000');
  sh.getRange(3, 2, 2, 5).setFontFamily('Arial').setFontSize(10);
  sh.getRange(3, 2, 2, 5).setValues([['AREA / MILL', ': ' + (o.mill || ''), '', 'AUDITOR', ': ' + (o.auditor || '')], ['AUDITEE', ': ' + (o.auditee || ''), '', 'DATE', ': ' + o.tgl1 + ' - ' + o.tgl2]]);
  sh.getRange(3, 2, 2, 1).setFontWeight('bold'); sh.getRange(3, 5, 2, 1).setFontWeight('bold');
  sh.setRowHeight(5, 12); let r = 6, n = 0;
  areas.forEach(a => {
    const its = all.filter(t => t.AreaID === a.ID).sort((x, y) => (Number(x.No) || 0) - (Number(y.No) || 0)); if (!its.length) return;
    sh.getRange(r, 1, 1, 8).merge().setValue('AREA / SUB-AREA: ' + a.Nama.toUpperCase()).setFontFamily('Arial').setFontWeight('bold').setFontColor('#1E3A8A').setBackground('#DCE6FF'); r++;
    sh.getRange(r, 1, 1, 8).setValues([HDR]).setFontFamily('Arial').setFontWeight('bold').setFontSize(9).setFontColor('#1F3FD1').setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true).setBorder(true, true, true, true, true, true, '#000000', BS); sh.setRowHeight(r, 34); r++;
    its.forEach(t => {
      sh.getRange(r, 1, 1, 8).setValues([[t.No, t.Remark, a.Nama, t.Kategori, '', '', t.PIC, t.Status]]).setFontFamily('Arial').setFontSize(10).setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true).setBorder(true, true, true, true, true, true, '#000000', BS);
      sh.getRange(r, 1).setBackground('#FFF176').setFontWeight('bold'); sh.getRange(r, 2).setHorizontalAlignment('left'); sh.setRowHeight(r, 130);
      [[5, t.FotoBefore], [6, t.FotoAfter]].forEach(p => { if (!p[1]) return; try { ogFit(sh.insertImage(DriveApp.getFileById(p[1]).getBlob(), p[0], r, 4, 4), 190, 122); } catch (e) {} });
      r++;
    });
    sh.setRowHeight(r, 20); r++;
  });
  SpreadsheetApp.flush(); return s.getId();
}

/** format = xlsx | docx | pdf | gdoc */
function exportHasil(pin, o) {
  try {
    if (!cekPin(pin).success) return res(false, null, 'Hanya admin yang dapat mengunduh hasil akhir.');
    const areas = rows_('Area').filter(a => o.areaIds.indexOf(a.ID) > -1);
    const all = rows_('Temuan').filter(t => { const d = String(t.Tanggal).slice(0, 10); return d >= o.tgl1 && d <= o.tgl2 && o.areaIds.indexOf(t.AreaID) > -1; });
    if (!areas.length) return res(false, null, 'Pilih minimal satu area.');
    if (!all.length) return res(false, null, 'Tidak ada temuan pada area dan tanggal tersebut.');
    const out = DriveApp.getFolderById(props().getProperty('OUT_ID')), stamp = Utilities.formatDate(new Date(), 'Asia/Jakarta', 'yyyyMMdd_HHmm');
    const tok = { headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() } };
    const share = f => f.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    if (o.format === 'xlsx') {
      const id = buatXlsx_(o, areas, all, stamp);
      const f = out.createFile(UrlFetchApp.fetch('https://docs.google.com/spreadsheets/d/' + id + '/export?format=xlsx', tok).getBlob().setName('Finding_6S_' + stamp + '.xlsx'));
      DriveApp.getFileById(id).setTrashed(true); share(f);
      return res(true, { url: 'https://drive.google.com/uc?export=download&id=' + f.getId() }, 'OK');
    }
    const id = buatDoc_(o, areas, all, stamp);
    if (o.format === 'gdoc') { const f = DriveApp.getFileById(id); f.moveTo(out); share(f); return res(true, { url: 'https://docs.google.com/document/d/' + id + '/edit' }, 'OK'); }
    const ext = o.format === 'pdf' ? 'pdf' : 'docx';
    const f = out.createFile(UrlFetchApp.fetch('https://docs.google.com/document/d/' + id + '/export?format=' + ext, tok).getBlob().setName('Finding_6S_' + stamp + '.' + ext));
    DriveApp.getFileById(id).setTrashed(true); share(f);
    return res(true, { url: 'https://drive.google.com/uc?export=download&id=' + f.getId() }, 'OK');
  } catch (e) { return res(false, null, 'Ekspor gagal: ' + e.message); }
}

// ═ LOGO (dari file yang Anda kirim) ═
const LOGO_APP = '';
const LOGO_6S = '';
